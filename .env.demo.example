APP_NAME="MKD CaisseConnect — Démo"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://demo.mkd-caisseconnect.com

# Identité commerciale de l'instance démo
BUSINESS_NAME="La Boutique Démo"
BUSINESS_TAGLINE="Commerce généraliste"
BUSINESS_SOCIAL="@mkd_caisseconnect"
